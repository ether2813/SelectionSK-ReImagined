{
  "manifest_version": 3,
  "name": "SelectionSK",
  "short_name": "SelectionSK",
  "description": "__MSG_addonDescChr__",
  "version": "7.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/SelectionSK_16.png",
    "24": "icons/SelectionSK_24.png",
    "32": "icons/SelectionSK_32.png",
    "48": "icons/SelectionSK_48.png",
    "64": "icons/SelectionSK_64.png",
    "128": "icons/SelectionSK_128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/SelectionSK_16.png",
      "24": "icons/SelectionSK_24.png",
      "32": "icons/SelectionSK_32.png",
      "48": "icons/SelectionSK_48.png",
      "64": "icons/SelectionSK_64.png"
    },
    "default_title": "SelectionSK"
  },
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "page_translate": {
      "suggested_key": {
        "default": "Ctrl+Shift+0"
      },
      "description": "Translate this page"
    },
    "conversion": {
      "suggested_key": {
        "default": "Ctrl+Shift+1"
      },
      "description": "Show converter"
    }
  },
  "omnibox": {
    "keyword": "t"
  },
  "permissions": [
    "bookmarks",
    "clipboardRead",
    "clipboardWrite",
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "notifications",
    "offscreen",
    "search",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "css/colors.css",
        "css/context_button.css",
        "css/context_menu.css",
        "css/context_panel.css",
        "css/translator.css",
        "css/converter.css"
      ],
      "js": [
        "lib/googleDocsUtil.js",
        "lib/mark.js",
        "src/shared/common.js",
        "src/shared/consts.js",
        "src/shared/utils.js",
        "src/shared/defaults.js",
        "src/content/translator.js",
        "src/content/converter.js",
        "src/content/mycroft.js",
        "src/content/content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
